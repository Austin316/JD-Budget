rules_version = '2';
// Paste this into Firebase: Firestore Database -> Rules -> Publish.
// Each signed-in Google account can only read and write its own budget.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
